# =============================================================================
# ai-guardrails-tutorial - environment template
#
# Copy this file to `.env` and fill in your own values:
#
#     Copy-Item .env.example .env      # Windows PowerShell
#     cp .env.example .env             # macOS / Linux
#
# `.env` is gitignored, so your keys stay local. NEVER commit a real API key.
#
# Every module (1-5) reads these same variables, so you only configure this once.
# =============================================================================


# -----------------------------------------------------------------------------
# Which backend to use
# -----------------------------------------------------------------------------
# true  -> local Ollama server (no API key needed, nothing leaves your machine)
# false -> any OpenAI-compatible API (OpenAI, vLLM, LM Studio, OpenRouter, ...)
#
# Modules 1 and 3 run their deterministic exercises without any backend at all,
# so you can start the course before configuring credentials.
USE_OLLAMA=false


# -----------------------------------------------------------------------------
# Ollama settings (used only when USE_OLLAMA=true)
# -----------------------------------------------------------------------------
# Run `ollama serve`, then pull the model you list here, e.g. `ollama pull llama3`.
# Leave BASE_URL blank to default to http://localhost:11434/v1
# The /v1 suffix matters: the tutorial talks to Ollama's OpenAI-compatible API.
#
# LLM_MODEL=llama3
# BASE_URL=http://localhost:11434/v1
# API_KEY=ollama


# -----------------------------------------------------------------------------
# OpenAI-compatible settings (used only when USE_OLLAMA=false)
# -----------------------------------------------------------------------------
# LLM_MODEL is the BARE model id - do not prefix it with "openai:".
# The tutorial passes it straight to OpenAIChatModel, which sends it to the API
# verbatim, so a prefix produces a "model not found" error.
LLM_MODEL=gpt-4o-mini

# Your API key. For OpenAI this starts with "sk-".
API_KEY=

# Leave blank for the real OpenAI endpoint (https://api.openai.com/v1).
# Set it when pointing at a self-hosted or third-party OpenAI-compatible server.
BASE_URL=


# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
# true -> enables verbose logging from the notebooks
DEBUG_MODE=false

# Reserved for modules that embed text. If you use a non-OpenAI provider you
# will need an embedding model reachable at BASE_URL.
# EMBEDDING_MODEL=text-embedding-3-small
